<ui:FluentWindow x:Class="ProtoTestTool.ScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        Title="Script Editor" Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Closing="Window_Closing">

    <ui:FluentWindow.Resources>
        <!-- Bottom Panel Tab Style -->
        <Style x:Key="PanelTabStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#E7E7E7"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E7E7E7"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- TitleBar -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="" Height="40" Padding="0">
            <ui:TitleBar.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Script Editor" VerticalAlignment="Center" Margin="15,0,15,0" FontWeight="SemiBold" FontSize="12"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ui:Button x:Name="BuildBtn" Content="Build &amp; Run" Icon="Play24" Appearance="Primary" Click="BuildBtn_Click" Margin="0,0,4,0" ToolTip="Ctrl+B"/>
                        <ui:Button x:Name="StopBtn" Content="Stop" Icon="Stop24" Appearance="Danger" Click="StopBtn_Click" Margin="0,0,4,0" IsEnabled="False" Visibility="Collapsed"/>
                        <ui:Button x:Name="DebugBtn" Content="Debug" Icon="Bug24" Appearance="Secondary" Click="DebugBtn_Click" Margin="0,0,4,0"/>
                        <Rectangle Width="1" Height="16" Fill="#3F3F46" Margin="4,0,8,0"/>
                        <ui:Button x:Name="PackagesBtn" Content="NuGet" Icon="AppGeneric24" Appearance="Secondary" Click="PackagesBtn_Click"/>
                        <Rectangle Width="1" Height="16" Fill="#3F3F46" Margin="8,0,8,0"/>
                        <ui:Button x:Name="RestartServerBtn" Content="Restart Server" Icon="ArrowClockwise24" Appearance="Transparent" Click="RestartServerBtn_Click" FontSize="11" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 1. Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>      <!-- Editor Area -->
                <RowDefinition Height="5"/>      <!-- Splitter -->
                <RowDefinition Height="Auto"/>   <!-- Panel Header -->
                <RowDefinition Height="150"/>    <!-- Panel Content -->
            </Grid.RowDefinitions>

            <!-- VS Code WebView2 / Fallback Editor -->
            <Grid Grid.Row="0">
                <!-- Loading Overlay -->
                <Border x:Name="LoadingOverlay" Background="#1E1E1E" Panel.ZIndex="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,12"/>
                        <TextBlock x:Name="LoadingText" Text="Starting VS Code Server..." Foreground="#CCCCCC" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingSubText" Text="" Foreground="#808080" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- VS Code WebView2 -->
                <wv2:WebView2 x:Name="VsCodeWebView" Visibility="Collapsed"/>

                <!-- Fallback: Monaco Editors (shown when VS Code not available) -->
                <Grid x:Name="MonacoFallbackGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Strip (Fallback only) -->
                    <Border Grid.Row="0" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Background="Transparent"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Editor Content (Fallback only) -->
                    <Grid Grid.Row="1" x:Name="EditorsGrid"/>
                </Grid>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#2D2D2D" ShowsPreview="True"/>

            <!-- Panel Header -->
            <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OutputTab" Content="OUTPUT" IsChecked="True" Checked="PanelTab_Checked" Style="{StaticResource PanelTabStyle}" Margin="0,0,12,0"/>
                    <RadioButton x:Name="DebugConsoleTab" Content="DEBUG CONSOLE" Checked="PanelTab_Checked" Style="{StaticResource PanelTabStyle}"/>
                </StackPanel>
            </Border>

            <!-- Panel Content -->
            <Grid Grid.Row="3">
                <!-- Output -->
                <RichTextBox x:Name="ScriptLogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             Background="#1E1E1E" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12"
                             BorderThickness="0" Margin="4" Visibility="Visible">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>

                <!-- Debug Console -->
                <Grid x:Name="DebugConsolePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0" x:Name="VariablesListView" Background="#1E1E1E" BorderThickness="0"
                              Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Value" Width="250" DisplayMemberBinding="{Binding Value}"/>
                                <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding Type}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
                        <Button x:Name="ContinueBtn" Content="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                Click="ContinueBtn_Click" ToolTip="Continue (F5)" Padding="8,4" Margin="0,0,4,0" IsEnabled="False"/>
                        <Button x:Name="StopDebugBtn" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                Click="StopDebugBtn_Click" ToolTip="Stop" Padding="8,4" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 2. Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Height="22">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                    <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#4EC9B0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerStatusText" Text="Starting..." Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="" Foreground="White" FontSize="11" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <TextBlock x:Name="EditorModeText" Text="" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock x:Name="PortText" Text="" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
