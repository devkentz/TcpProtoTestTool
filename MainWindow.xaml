<ui:FluentWindow x:Class="ProtoTestTool.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
                 mc:Ignorable="d"
                 Title="TCP Packet Lab" Height="800" Width="1200"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 xmlns:controls="clr-namespace:ProtoTestTool.Controls"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 1. Title Bar with Header Content -->
        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="3" Title="TCP Packet Lab" Height="46" Padding="10,0">
            <ui:TitleBar.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Mode Switcher (Left) -->
                    <Border Grid.Column="0" Background="{DynamicResource BgBrush}" CornerRadius="18" Padding="3" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Test Client" IsChecked="True" Click="ModeClient_Click" Width="100" />
                            <RadioButton Content="Proxy" Click="ModeProxy_Click" Width="110" />
                        </StackPanel>
                    </Border>

                    <!-- Workspace Controls (Right) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ui:Button x:Name="WorkspaceBtn" Icon="Folder24" Content="Workspace" Click="WorkspaceBtn_Click"
                                   Margin="0,0,15,0" Appearance="Secondary" />
                        <TextBlock x:Name="WorkspacePathText" Text=""
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,15,0" MaxWidth="200"
                                   TextTrimming="CharacterEllipsis" />


                        <ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       FontSize="16" ToolTip="Hot Reload Active" />
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 2. Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Codec -->
                    <RowDefinition Height="Auto" /> <!-- Divider -->
                    <RowDefinition Height="*" />    <!-- Spacer -->
                    <RowDefinition Height="Auto" /> <!-- Divider -->
                    <RowDefinition Height="Auto" /> <!-- State -->
                </Grid.RowDefinitions>

                <!-- Codec Config -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="CODEC CONFIGURATION" Foreground="{DynamicResource SmallTextBrush}" FontSize="11" FontWeight="Bold"
                               Margin="0,0,0,10" />
                    <ui:Button x:Name="ReloadProtoBtn" Content="Reload Proto" Click="ReloadProtoBtn_Click"
                               Icon="ArrowClockwise24" HorizontalAlignment="Stretch" Appearance="Secondary" />
                    <ui:Button x:Name="ViewProtoSourceBtn" Content="View Proto Source" Click="ViewProtoSourceBtn_Click"
                               Icon="DocumentOnePage24" HorizontalAlignment="Stretch" Margin="0,5,0,0" />

                    <!-- Hidden Proto Buttons mapped to Codec area -->
                    <ListBox x:Name="ProtoFileListBox" Height="100" Margin="0,5" Visibility="Collapsed" />
                    <TextBox x:Name="ProtoLogBox" Visibility="Collapsed" />
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource PanelBorderBrush}" Margin="0,0,0,12" />

                <!-- Divider -->
                <Rectangle Grid.Row="3" Height="1" Fill="{DynamicResource PanelBorderBrush}" Margin="0,12,0,12" />

                <!-- State Store (pushed to bottom) -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="STATE STORE" Foreground="{DynamicResource SmallTextBrush}" FontSize="11" FontWeight="Bold"
                               Margin="0,0,0,10" />
                    <ui:Button Content="Reset State" Click="ResetState_Click" Icon="Delete24" Appearance="Danger"
                               HorizontalAlignment="Stretch" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Sidebar Splitter -->
        <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- 3. Main Content -->
        <Grid Grid.Row="1" Grid.Column="2" Margin="20">

            <!-- VIEW 1: Test Client -->
            <Grid x:Name="ClientView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Connection (Shared) -->
                    <RowDefinition Height="*" />    <!-- Tabs -->
                    <RowDefinition Height="Auto" /> <!-- Splitter -->
                    <RowDefinition Height="150" MinHeight="100" />  <!-- Logs (Shared) -->
                </Grid.RowDefinitions>

                <!-- Connection Panel -->
                <ui:Card Grid.Row="0" Padding="15" Margin="0,0,0,15" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /> <!-- Connection label -->
                            <ColumnDefinition Width="Auto" /> <!-- Target label -->
                            <ColumnDefinition Width="Auto" /> <!-- IP -->
                            <ColumnDefinition Width="Auto" /> <!-- : -->
                            <ColumnDefinition Width="Auto" /> <!-- Port -->
                            <ColumnDefinition Width="Auto" /> <!-- Connect -->
                            <ColumnDefinition Width="*" />    <!-- Spacer -->
                            <ColumnDefinition Width="Auto" /> <!-- Script Editor -->
                            <ColumnDefinition Width="Auto" /> <!-- REC -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Connection" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                   Margin="0,0,20,0" />

                        <TextBlock Grid.Column="1" Text="Target:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBox Grid.Column="2" x:Name="IpBox" Text="127.0.0.1" Width="140" Margin="5,0" TabIndex="0" />
                        <TextBlock Grid.Column="3" Text=":" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Column="4" x:Name="PortBox" Text="9000" Width="80" Margin="5,0" TabIndex="1" />

                        <ui:Button Grid.Column="5" x:Name="ConnectToggleBtn" Content="Connect" Click="ConnectToggleBtn_Click"
                                   Width="120" Margin="10,0" Appearance="Primary" Icon="PlugConnected24" TabIndex="2" />

                        <ui:Button Grid.Column="7" Content="Script Editor" Click="OpenScriptEditor_Click" Margin="0,0,10,0" Width="120"
                                   Icon="Code24" />

                        <!-- Client Record Button -->
                        <ToggleButton Grid.Column="8" x:Name="ClientRecordBtn" Click="ClientRecordBtn_Click"
                                      Width="100" Foreground="#FF5555" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Record24" Margin="0,0,8,0" />
                                <TextBlock Text="REC" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </ui:Card>

                <!-- Tabs -->
                <TabControl Grid.Row="1">
                    <TabItem Header="Manual Send">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Pipeline -->
                                <RowDefinition Height="Auto" /> <!-- Interceptors -->
                                <RowDefinition Height="*" />    <!-- Inspector -->
                            </Grid.RowDefinitions>

                            <!-- Packet Selection & Action -->
                            <ui:Card Grid.Row="0" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Selector and Info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Select Packet Type:"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,0,8" FontSize="13" />
                                        <DockPanel>
                                            <controls:PacketSelector x:Name="PacketSelectorControl" MinWidth="300"
                                                                     Width="400" Height="35" HorizontalAlignment="Left"
                                                                     PacketSelected="PacketSelectorControl_PacketSelected" />
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Send Button -->
                                    <ui:Button x:Name="SendBtn" Grid.Column="1" Content="Send Packet" Width="140"
                                               Height="40" Click="SendBtn_Click" IsEnabled="False" Appearance="Primary"
                                               Icon="Send24" VerticalAlignment="Bottom" />
                                </Grid>
                            </ui:Card>

                            <!-- Interceptors for Manual Send -->
                            <Expander Grid.Row="1" Header="Interceptors" Padding="0" Margin="0,0,0,15" IsExpanded="False">
                                <controls:InterceptorSelector x:Name="ClientInterceptorSelector" Height="150" />
                            </Expander>

                            <!-- Inspector -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Request Inspector -->
                                <ui:Card Grid.Column="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                         Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Request Inspector" Margin="15,10" FontWeight="Bold" />
                                        <TabControl Grid.Row="1" Margin="5">
                                            <TabItem Header="Body (JSON)">
                                                <controls:MonacoEditor x:Name="JsonEditorView" EditorLanguage="json"
                                                                       ShowMinimap="False" IsReadOnly="False"
                                                                       VerticalAlignment="Stretch"
                                                                       HorizontalAlignment="Stretch" />

                                            </TabItem>
                                            <TabItem Header="Header (JSON)">
                                                <controls:MonacoEditor x:Name="HeaderJsonEditorView"
                                                                       EditorLanguage="json" ShowMinimap="False"
                                                                       IsReadOnly="False" VerticalAlignment="Stretch"
                                                                       HorizontalAlignment="Stretch" />

                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </ui:Card>

                                <!-- Response Inspector -->
                                <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                         Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Response Inspector" Margin="15,10" FontWeight="Bold" />
                                        <TabControl Grid.Row="1" Margin="5">
                                            <TabItem Header="Body (JSON)">
                                                <controls:MonacoEditor x:Name="ResponseBoxView" EditorLanguage="json"
                                                                       ShowMinimap="True" IsReadOnly="True"
                                                                       VerticalAlignment="Stretch"
                                                                       HorizontalAlignment="Stretch" />

                                            </TabItem>
                                            <TabItem Header="Headers">
                                                <DataGrid x:Name="ResponseHeaderGrid" AutoGenerateColumns="False"
                                                          IsReadOnly="True" BorderThickness="0"
                                                          Background="Transparent">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}"
                                                                            Width="*" />
                                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}"
                                                                            Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </ui:Card>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Replay Tab -->
                    <TabItem Header="Replay">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Replay Controls -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:Button x:Name="LoadRecordingBtn" Content="Load Recording" Icon="FolderOpen24" Click="LoadRecordingBtn_Click" />
                                <TextBlock x:Name="ReplayFileNameText" Text="No file loaded" VerticalAlignment="Center"
                                           Margin="10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button x:Name="ReplayAllBtn" Content="Replay All" Icon="Play24" Appearance="Primary" Margin="20,0,0,0"
                                           Click="ReplayAllBtn_Click" />
                            </StackPanel>

                            <!-- Replay Interceptors -->
                            <Expander Grid.Row="1" Header="Replay Interceptors" IsExpanded="False" Margin="0,0,0,10">
                                <controls:InterceptorSelector x:Name="ReplayInterceptorSelector" Height="150" />
                            </Expander>

                            <!-- Content Split -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="300" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Packet List -->
                                <DataGrid x:Name="ReplayPacketGrid" Grid.Column="0" AutoGenerateColumns="False"
                                          IsReadOnly="True" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}"
                                          SelectionChanged="ReplayPacketGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100" />
                                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80" />
                                        <DataGridTextColumn Header="Packet" Binding="{Binding PacketName}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                <!-- Content Viewer -->
                                <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                         Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Packet Inspector" Margin="10,5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TabControl Grid.Row="1" Margin="5">
                                            <TabItem Header="Body (JSON)">
                                                <controls:MonacoEditor x:Name="ReplayBodyJsonViewer"
                                                                       EditorLanguage="json" ShowMinimap="False"
                                                                       IsReadOnly="True" VerticalAlignment="Stretch"
                                                                       HorizontalAlignment="Stretch" />

                                            </TabItem>
                                            <TabItem Header="Header (JSON)">
                                                <controls:MonacoEditor x:Name="ReplayHeaderJsonViewer"
                                                                       EditorLanguage="json" ShowMinimap="False"
                                                                       IsReadOnly="True" VerticalAlignment="Stretch"
                                                                       HorizontalAlignment="Stretch" />

                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </ui:Card>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Splitter -->
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <!-- System Logs -->
                <ui:Card Grid.Row="3" Margin="0,5,0,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="System Logs" Margin="15,10" FontWeight="Bold" />
                            <ui:Button Icon="Delete24" Appearance="Secondary" Click="ClearLogBtn_Click"
                                       ToolTip="Clear Logs" DockPanel.Dock="Right" Margin="0,0,10,0"
                                       Padding="4,2" FontSize="11" />
                        </DockPanel>
                        <RichTextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto" Background="Transparent"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" BorderThickness="0"
                                     Margin="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Top">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- VIEW 2: Reverse Proxy -->
            <Grid x:Name="ProxyView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:Card Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Proxy Configuration" FontWeight="Bold" Margin="0,0,0,10" FontSize="14" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <!-- Local Port label -->
                                <ColumnDefinition Width="Auto" /> <!-- Local Port box -->
                                <ColumnDefinition Width="Auto" /> <!-- Target label -->
                                <ColumnDefinition Width="Auto" /> <!-- Target IP -->
                                <ColumnDefinition Width="Auto" /> <!-- : -->
                                <ColumnDefinition Width="Auto" /> <!-- Target Port -->
                                <ColumnDefinition Width="Auto" /> <!-- Start Proxy -->
                                <ColumnDefinition Width="*" />    <!-- Spacer -->
                                <ColumnDefinition Width="Auto" /> <!-- Script Editor -->
                                <ColumnDefinition Width="Auto" /> <!-- REC -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Local Port:" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ui:TextBox Grid.Column="1" x:Name="ProxyLocalPortBox" Text="9000" Width="80" />
                            <TextBlock Grid.Column="2" Text="Target:" VerticalAlignment="Center" Margin="15,0,5,0" />
                            <ui:TextBox Grid.Column="3" x:Name="ProxyTargetIpBox" Text="127.0.0.1" Width="140" />
                            <TextBlock Grid.Column="4" Text=":" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Column="5" x:Name="ProxyTargetPortBox" Text="9001" Width="80" />
                            <ui:Button Grid.Column="6" x:Name="ProxyStartBtn" Content="Start Proxy" Margin="20,0,0,0"
                                       Click="ProxyStartBtn_Click" Appearance="Primary" />

                            <ui:Button Grid.Column="8" Content="Script Editor" Click="OpenScriptEditor_Click" Margin="0,0,10,0"
                                       Width="120" Icon="Code24" />

                            <!-- Proxy Record Button -->
                            <ToggleButton Grid.Column="9" x:Name="ProxyRecordBtn" Click="ProxyRecordBtn_Click"
                                          Width="100" Foreground="#FF5555" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Record24" Margin="0,0,8,0" />
                                    <TextBlock Text="REC" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                    </Grid>
                </ui:Card>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Card Grid.Column="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Interceptors" Margin="15,10" FontWeight="Bold" />
                            <controls:InterceptorSelector x:Name="ProxyInterceptorSelector" Grid.Row="1" Margin="5" />
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Column="1" VerticalAlignment="Stretch" Padding="0" VerticalContentAlignment="Stretch"
                             Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Proxy Logs" Margin="15,10" FontWeight="Bold" />
                            <TextBox x:Name="ProxyLogBox" Grid.Row="1" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="Transparent"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" BorderThickness="0"
                                     Margin="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Top" />
                        </Grid>
                    </ui:Card>
                </Grid>
            </Grid>
        </Grid>

        <!-- 4. Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False" Margin="10,0">
                <!-- Status Indicator -->
                <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="{DynamicResource SystemFillColorSuccessBrush}"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Ready" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                           VerticalAlignment="Center" />

                <!-- Separator -->
                <Rectangle Width="1" Height="14" Fill="{DynamicResource PanelBorderBrush}"
                           VerticalAlignment="Center" Margin="12,0" />

                <!-- Mode Text -->
                <TextBlock x:Name="StatusModeText" Text="Test Client" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />

                <!-- Right-aligned response status -->
                <TextBlock x:Name="ResponseStatusText" Text="" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>

    </Grid>
</ui:FluentWindow>