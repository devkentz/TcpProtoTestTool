<UserControl x:Class="ProtoTestTool.Controls.InterceptorSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Active Interceptors" FontSize="12" FontWeight="Bold" Margin="0,0,0,5" 
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <ListBox x:Name="InterceptorList" Grid.Row="1" SelectionMode="Multiple"
                 BorderThickness="1" BorderBrush="#333333" Background="#1E1E1E">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsActive}" 
                              Checked="OnCheckChanged" Unchecked="OnCheckChanged"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
