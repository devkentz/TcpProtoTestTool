<Window x:Class="ProtoTestTool.Controls.InputNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        Title="Enter Name" Height="180" Width="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    
    <StackPanel Margin="20">
        <TextBlock Text="Enter Interceptor Name:" FontSize="14" Margin="0,0,0,10" 
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        
        <TextBox x:Name="InputBox" Margin="0,0,0,20" />
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Appearance="Secondary"/>
            <ui:Button Content="OK" Click="Ok_Click" Appearance="Primary" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
